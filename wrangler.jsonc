{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nostalgichillax",
  "compatibility_date": "2025-02-04",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist",
  "observability": {
    "enabled": true
  },
  "headers": [
    { "name": "X-Content-Type-Options", "value": "nosniff" },
    { "name": "X-Frame-Options", "value": "DENY" },
    { "name": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://nostalgiachillax.pages.dev; font-src 'self'; img-src 'self' data: https:;" }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "c0f509b2af8d4e47ad5eb6611c33d19b",
      "localConnectionString": "postgresql://neondb_owner:npg_8NHGKVq5TOWh@ep-rough-pond-ay9tusfw-pooler.c-5.us-east-2.aws.neon.tech/jasper?sslmode=require&channel_binding=require"
    }
  ]
}

# Copy to .env.local and fill in real values. Never commit secrets.

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=dev:<your-deployment>

# Public (non-secret) frontend config
VITE_CONVEX_URL=https://<your-deployment>.convex.cloud
VITE_CONVEX_SITE_URL=https://<your-deployment>.convex.site

# Secrets — also set on the Convex deployment via `npx convex env set`
ROOT_EMAIL=root@root.root
BETTER_AUTH_SECRET=

# --- Cloudflare Pages deployment ---
# Build command: npm run build    Output dir: dist
# Set these two in the Pages dashboard (Build settings > Environment variables);
# Vite bakes them in at BUILD time, so they are not read at runtime:
#   VITE_CONVEX_URL=https://<your-deployment>.convex.cloud
#   VITE_CONVEX_SITE_URL=https://<your-deployment>.convex.site
# After the first deploy, allow the new origin for Better Auth:
#   npx convex env set SITE_URL https://<your-pages-project>.pages.dev
# Tip: point preview-branch deploys at a separate dev Convex deployment so
# previews never touch production player data.
# Optional telemetry — leave unset to disable Sentry entirely.
# Create a project at sentry.io, paste the DSN here (and in Cloudflare Pages
# env vars at build time) to enable crash reporting.
VITE_SENTRY_DSN=
